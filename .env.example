# ------------------------------------------------------------------
# ENI Colis Services — variables d'environnement
# Copier ce fichier en `.env` et renseigner les valeurs.
# `.env` est ignoré par Git : aucun secret ne doit être commité.
# ------------------------------------------------------------------

# --- Base de données ----------------------------------------------
# PostgreSQL en dev comme en prod : les migrations Prisma sont propres à
# un moteur, on ne teste pas sur autre chose que ce qui tourne en prod.
#
# Dev  : `docker compose up -d` (port 5433), ou une branche Neon.
# Prod : Neon, RÉGION EUROPE obligatoire (RGPD)
#        postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/eni?sslmode=require
DATABASE_URL="postgresql://eni:eni@localhost:5433/eni_colis?schema=public"

# --- Site ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Numéro WhatsApp d'ENI, au format international sans « + » ni espace.
# Sert à construire les liens wa.me pré-remplis.
NEXT_PUBLIC_WHATSAPP="33652707014"

# --- Authentification du back-office (lot 7) -----------------------
# Générer avec : openssl rand -base64 32
# Auth.js v5 lit AUTH_SECRET. NEXTAUTH_SECRET reste accepte pour
# compatibilite : on renseigne les deux a la meme valeur.
AUTH_SECRET=""
NEXTAUTH_SECRET=""
# NEXTAUTH_URL n'est PAS utilisée, et ne doit pas être définie.
#
# `auth.config.ts` pose `trustHost: true` : Auth.js v5 déduit l'URL de la
# requête, ce qui est exactement ce qu'il faut quand le site répond sur
# plusieurs domaines (le domaine propre ET l'adresse .vercel.app).
#
# Le 18 septembre 2026, cette variable a mis le back-office hors service en
# production. Renseignée avec une valeur qu'Auth.js n'a pas su analyser,
# elle faisait échouer l'initialisation du middleware : toute URL sous
# /admin répondait 500 (MIDDLEWARE_INVOCATION_FAILED), y compris la page de
# connexion. Les pages publiques, hors du matcher, restaient intactes — ce
# qui rend la panne d'autant plus facile à ne pas voir.
#
# Elle a été SUPPRIMÉE de Vercel. Ne pas la remettre.

# --- E-mails transactionnels — Resend (lot 6) ----------------------
RESEND_API_KEY=""
EMAIL_FROM="noreply@enicolisservices.com"
EMAIL_INTERNAL="contact@enicolisservices.com"

# --- Stockage des photos de devis (lot 6) --------------------------
# Vercel Blob, RÉGION EUROPE : les photos clients sont des données
# personnelles, elles ne quittent pas l'Union européenne.
BLOB_READ_WRITE_TOKEN=""

# --- Taux de change ------------------------------------------------
# Parité fixe euro / franc CFA (XOF et XAF). En variable pour la
# traçabilité : si la parité change, la valeur est modifiée ici et
# les documents déjà émis conservent leur taux figé en base.
TAUX_CFA="655.957"

# Indexation par les moteurs de recherche.
# Laisser vide jusquà la recette du lot 10 ; mettre "active" pour ouvrir.
NEXT_PUBLIC_INDEXATION=""

# Mot de passe des comptes de demonstration cree par le seed.
# A ne jamais utiliser en production.
SEED_MOT_DE_PASSE="eni-demo-2026"
